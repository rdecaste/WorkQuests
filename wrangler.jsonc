{
  // Work Garden: one Worker, its page and its D1 database. You get in through Roy OS
  // (a one-time pass over its service binding to GardenPass, src/pass.js) or Cloudflare Access.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-garden",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  // The page. run_worker_first: every request, the page included, goes
  // through the Access check in src/access.js first.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-garden",
      "database_id": "5d19a52b-ebc2-43a5-8320-f370d6c52dc1",
      "migrations_dir": "migrations"
    }
  ],
  // The landscape's still and loop (landscape/…), served at /media/ behind the sign-in.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "work-garden-media" }],
  // Paints the landscape: OpenAI still, then Gemini loop (src/landscape.js, class in src/entry.js).
  // And each plant's first picture, its seed (src/plantpicture.js, class PlantPicture).
  "workflows": [
    { "name": "work-garden-scene", "binding": "GARDEN_SCENE", "class_name": "GardenScene" },
    { "name": "work-garden-plant", "binding": "PLANT_PICTURE", "class_name": "PlantPicture" }
  ],
  // Roy OS paints the pictures and drafts "Frame it with AI" with its keys (its Studio entrypoint, service binding only).
  "services": [{ "binding": "STUDIO", "service": "royos", "entrypoint": "Studio" }],
  "vars": {
    // The Access team (billowing-boat-2009.cloudflareaccess.com) and the
    // application's audience tag (Zero Trust → Access → Applications → the app → Overview).
    // Without both, and the ALLOWED_EMAILS secret, the Worker lets no one in.
    "ACCESS_TEAM": "billowing-boat-2009",
    "ACCESS_AUD": "ba6b77f77ea2237fb44beb1b89cf7975bb767cc97d4f645f18d41a7e22b17fa8",
    // Visitors without a session go to Roy OS's /go/garden, which sends them back with a pass.
    "ROYOS_URL": "https://royos.quest-engine.workers.dev",
    // This Worker's own address, for the signed link Gemini reads the still from.
    "PUBLIC_URL": "https://work-garden.quest-engine.workers.dev"
  }
  // Secrets (npx wrangler secret put NAME):
  //   ALLOWED_EMAILS  who may use it, comma-separated
  //   OPENAI_API_KEY, GEMINI_API_KEY  only without the STUDIO binding (Roy OS paints with its own keys);
  //                   (the same OPENAI_API_KEY drafts "Frame it with AI" without STUDIO; CHAT_MODEL var overrides gpt-6-astra)
  // Models: IMAGE_MODEL and VIDEO_MODEL vars override gpt-image-2.5-flare and gemini-omni-flash-preview.
}
