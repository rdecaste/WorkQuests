{
  // Work Garden: one Worker, its page and its D1 database. You get in through Roy OS
  // (a one-time pass over its service binding to GardenPass, src/pass.js) or Cloudflare Access.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-garden",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  // The page. run_worker_first: every request, the page included, goes
  // through the Access check in src/access.js first.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-garden",
      "database_id": "5d19a52b-ebc2-43a5-8320-f370d6c52dc1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The Access team (billowing-boat-2009.cloudflareaccess.com) and the
    // application's audience tag (Zero Trust → Access → Applications → the app → Overview).
    // Without both, and the ALLOWED_EMAILS secret, the Worker lets no one in.
    "ACCESS_TEAM": "billowing-boat-2009",
    "ACCESS_AUD": "ba6b77f77ea2237fb44beb1b89cf7975bb767cc97d4f645f18d41a7e22b17fa8",
    // Visitors without a session go to Roy OS's /go/garden, which sends them back with a pass.
    "ROYOS_URL": "https://royos.quest-engine.workers.dev"
  }
  // Secrets (npx wrangler secret put NAME):
  //   ALLOWED_EMAILS  who may use it, comma-separated
  // Later steps: OPENAI_API_KEY (step 2 and 3), GEMINI_API_KEY (step 3).
}
